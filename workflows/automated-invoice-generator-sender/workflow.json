        "googleDriveOAuth2Api": {
          "id": "YOUR_GOOGLE_DRIVE_CREDENTIAL_ID",
          "name": "Google Drive OAuth2 API"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const docId = $json.id;\nconst sheet = $('Get row(s) in sheet').item.json;\n\nconst item = {\n  docId: docId,\n\n  name: sheet.NAME || sheet.EMAIL?.split('@')[0] || 'Client',\n  email: sheet.EMAIL || '',\n  service: sheet.SERVICE || '',\n\n  amount: new Intl.NumberFormat('en-US', {\n    minimumFractionDigits: 2,\n    maximumFractionDigits: 2\n  }).format(Number(sheet.AMOUNT || 0)),\n\n  date: new Date().toLocaleDateString('en-US', {\n    year: 'numeric',\n    month: 'long',\n    day: 'numeric'\n  }),\n\n  invoiceNo: 'INV-' + Date.now().toString().slice(-6)\n};\n\nreturn { json: item };"
      },
      "id": "2ffe4e8d-4f4e-46c6-adbc-00af43972c38",
      "name": "Build Field Map",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-384, -1216]
    },
    {
      "parameters": {
        "operation": "update",
        "documentURL": "={{ $json.docId }}",
        "actionsUi": {
          "actionFields": [
            { "action": "replaceAll", "text": " {{InvoiceNo}}", "replaceText": "={{ $json.invoiceNo }}" },
            { "action": "replaceAll", "text": "{{Date}}", "replaceText": "={{ $json.date }}" },
            { "action": "replaceAll", "text": "{{Name}}", "replaceText": "={{ $json.name }}" },
            { "action": "replaceAll", "text": "{{Email}}", "replaceText": "={{ $json.email }}" },
            { "action": "replaceAll", "text": "{{Service}}", "replaceText": "={{ $json.service }}" },
            { "action": "replaceAll", "text": " {{Amount}} ", "replaceText": "={{ $json.amount }}" }
          ]
        }
      },
      "id": "aeb2ff33-79b7-4026-bc95-ccc64543e406",
