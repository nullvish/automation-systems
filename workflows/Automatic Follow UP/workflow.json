    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a professional business representative.\n\nWrite a warm, concise follow-up email to a lead who submitted an inquiry.\n\nLead Details:\n- Name: {{ $json.NAME }}\n- Service Requested: {{ $json['SERVICE'] }}\n- Location: {{ $json.LOCATION }}\n- Preferred Date: {{ $json.DATE }}\n\nThe email should:\n1. Thank them for reaching out\n2. Confirm receipt of their inquiry for {{ $json['SERVICE'] }}\n3. Let them know someone will be in touch shortly to discuss details\n4. Keep it concise, professional, and human\n\nDo NOT include a subject line. Start directly with the greeting.",
        "options": {}
      },
