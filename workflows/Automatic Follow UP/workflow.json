    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const emailBody = $json.output;\n\nconst html = `<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n<title>Follow-Up</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#f4f4f4;\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#f4f4f4\">\n<tr>\n<td align=\"center\" style=\"padding:40px 16px;\">\n  <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;\">\n\n    <tr>\n      <td align=\"center\" bgcolor=\"#1a1a2e\" style=\"padding:32px 48px 24px 48px;\">\n        <p style=\"margin:0;font-family:Georgia,serif;font-size:20px;letter-spacing:3px;text-transform:uppercase;color:#ffffff;\">\n          YOUR COMPANY NAME\n        </p>\n        <p style=\"margin:6px 0 0 0;font-family:Arial,sans-serif;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:#888888;\">\n          Follow-Up\n        </p>\n      </td>\n    </tr>\n\n    <tr>\n      <td bgcolor=\"#ffffff\" style=\"padding:36px 48px 40px 48px;\">\n        <p style=\"margin:0;font-family:Georgia,serif;font-size:15px;line-height:1.9;color:#333333;white-space:pre-line;\">\n          ${emailBody}\n        </p>\n      </td>\n    </tr>\n\n    <tr>\n      <td bgcolor=\"#f9f9f9\" style=\"padding:24px 48px 28px 48px;border-top:1px solid #eeeeee;\">\n        <p style=\"margin:0 0 3px 0;font-family:Arial;font-size:12px;font-weight:bold;color:#333333;\">\n          YOUR NAME\n        </p>\n        <p style=\"margin:0;font-family:Arial;font-size:11px;color:#888888;\">\n          YOUR COMPANY | YOUR CONTACT\n        </p>\n      </td>\n    </tr>\n\n    <tr>\n      <td align=\"center\" style=\"padding:16px 0;\">\n        <p style=\"margin:0;font-family:Arial;font-size:9px;color:#cccccc;\">\n          Automated Follow-Up · YOUR COMPANY\n        </p>\n      </td>\n    </tr>\n\n  </table>\n</td>\n</tr>\n</table>\n</body>\n</html>`;\n\nreturn {\n  json: {\n    ...$json,\n    htmlEmail: html,\n    plainText: emailBody\n  }\n};"
      },
